{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbiscreen",
  "version": "0.25.0",
  "identifier": "com.orbiscreen.gui",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Orbiscreen Dashboard",
        "width": 880,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://127.0.0.1:*;"
    }
  }
}
